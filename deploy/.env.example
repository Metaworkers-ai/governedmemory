# Copy this file to .env in the repo root and fill in your values.
# Never commit .env to git (it is in .gitignore).

# ---- Database (required) ----
# Local Docker (matches deploy/docker-compose.yml):
DATABASE_URL=postgresql://mw:mw_dev_password@localhost:5432/governedmemory

# AWS RDS example:
# DATABASE_URL=postgresql://mw:<password>@<rds-endpoint>:5432/governedmemory

# GCP Cloud SQL (via Cloud SQL Auth Proxy):
# DATABASE_URL=postgresql://mw:<password>@127.0.0.1:5432/governedmemory

# Azure Postgres Flexible Server:
# DATABASE_URL=postgresql://mw%40<server-name>:<password>@<server-name>.postgres.database.azure.com:5432/governedmemory

# Supabase:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Embedding model (optional — defaults shown) ----
# Which SentenceTransformer model to use (local provider only).
# 768-dim: all-mpnet-base-v2 (default, best quality)
# 384-dim: all-MiniLM-L6-v2  (faster, smaller download)
# If you change this, you must also update the vector(N) column via a migration.
EMBEDDING_MODEL=all-mpnet-base-v2

# ---- Governance thresholds ----
# injection_score above this marks a write as untrusted (E5 will tune this)
INJECTION_THRESHOLD=0.7

# ---- OpenAI (optional — enables real semantic search) ----
# If set, the API server (api/main.py:_build_embedder) uses OpenAI embeddings
# instead of NullEmbeddingProvider's zero-vectors -- no other config needed.
# The key is read server-side only (via the openai SDK) and is never sent to
# or exposed by the frontend.
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # or text-embedding-3-large
# EMBEDDING_DIM=768   # truncated via OpenAI's `dimensions` param to match
#                      # this repo's existing vector(768) column -- no
#                      # migration needed unless you change this

# ---- Cohere (optional — only if using CohereEmbeddingProvider) ----
# COHERE_API_KEY=...
