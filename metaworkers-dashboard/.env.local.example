# Copy to .env.local to enable the live-data sections (API Routes,
# Statistics, Executive Summary) against a running GovernedMemory backend.
# Everything else in this dashboard is static reporting and needs no config.
#
# Same variable names as ../governedmemory/web/.env.example -- both
# frontends can point at the same backend deployment.

# Base URL of the GovernedMemory REST API (api/main.py).
GOVERNEDMEMORY_API_URL=http://localhost:8000

# One tenant's Bearer API key, from that server's GOVERNEDMEMORY_API_KEYS.
GOVERNEDMEMORY_API_KEY=demo-key
