# Server-only -- never prefix these with NEXT_PUBLIC_, or the API key would
# ship in the browser bundle. Every backend call happens in Server
# Components / Server Actions (see lib/backend.ts), never from the client.

# Base URL of the governedmemory REST API (E7). No trailing slash needed.
GOVERNEDMEMORY_API_URL=http://localhost:8000

# One tenant's API key. This app is single-tenant-per-deployment: the REST
# API resolves tenant_id entirely from this key (see ../api/auth.py), so
# there's no tenant switcher in the UI -- run one deployment per tenant.
GOVERNEDMEMORY_API_KEY=some-secret-key
