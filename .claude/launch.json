{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit-frontend",
      "runtimeExecutable": "conda",
      "runtimeArgs": ["run", "-n", "mw", "streamlit", "run", "frontend/app.py", "--server.headless", "true"],
      "port": 8501
    },
    {
      "name": "web-nextjs",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "landing-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4321", "--directory", "site"],
      "port": 4321
    }
  ]
}
